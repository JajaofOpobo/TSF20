<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#ffe3e3e3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:background="@drawable/public_title_background"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffe5e9eb"
            android:gravity="center"
            android:id="@+id/theme_top_menu_local_text"
            android:background="@drawable/theme_local_selector"
            android:clickable="true"
            android:layout_width="152dp"
            android:layout_height="38dp"
            android:text="@string/theme_local"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffe5e9eb"
            android:gravity="center"
            android:id="@+id/theme_top_menu_online_text"
            android:background="@drawable/theme_online_selector"
            android:clickable="true"
            android:layout_width="152dp"
            android:layout_height="38dp"
            android:text="@string/theme_online"/>
    </LinearLayout>
    <com.tsf.shell.theme.inside.ThemeViewFilpper
        android:id="@+id/viewflipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp">
            <GridView
                android:id="@+id/local_theme_gridview"
                android:background="#ffe5e9eb"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@drawable/theme_item_selector"
                android:horizontalSpacing="5dp"
                android:verticalSpacing="13dp"
                android:numColumns="auto_fit"
                android:layout_weight="1"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <GridView
                android:id="@+id/online_theme_gridview"
                android:background="#ffe5e9eb"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:listSelector="@drawable/theme_item_selector"
                android:horizontalSpacing="5dp"
                android:verticalSpacing="13dp"
                android:numColumns="auto_fit"
                android:layout_above="@+id/google_play_button"/>
            <RelativeLayout
                android:id="@+id/google_play_button"
                android:background="@drawable/theme_buttom_bar_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/theme_google_play"
                    android:background="@drawable/theme_download_more"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginRight="11dp"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:id="@+id/theme_market_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </com.tsf.shell.theme.inside.ThemeViewFilpper>
</LinearLayout>
