<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ScrollView01"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/tertiary_text_light"
            android:id="@+id/TextView02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/menu_setting_density_notic"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="130dp">
            <ImageView
                android:id="@+id/setting_scale_icon"
                android:layout_width="172px"
                android:layout_height="172px"
                android:layout_marginTop="10dp"
                android:src="@drawable/menu_setting_resolution_test_icon"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/RelativeLayout01"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp">
            <TextView
                android:textColor="@android:color/tertiary_text_light"
                android:id="@+id/setting_scale_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <CheckBox
                android:id="@+id/setting_scale_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textColor="@android:color/tertiary_text_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_setting_density_auto"
                android:layout_toRightOf="@+id/setting_scale_checkbox"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <SeekBar
            android:id="@+id/setting_scale_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="5dp"/>
    </LinearLayout>
</ScrollView>
