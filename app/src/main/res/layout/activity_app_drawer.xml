<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background">

    <EditText
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/abc_search_hint"
        android:inputType="text"
        android:background="@null"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/launcher_text_primary"
        android:textColorHint="@color/launcher_text_secondary" />

    <ImageButton
        android:id="@+id/close_button"
        style="@android:style/Widget.Holo.Button.Borderless"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:src="@drawable/custom_dialog_close"
        android:background="@null"
        android:contentDescription="@string/abc_action_mode_done" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="88dp"
        android:clipToPadding="false"
        android:padding="8dp" />

</FrameLayout>
